---
import Layout from '../../../layouts/Layout.astro';
import AppNav from '../../../components/AppNav';
import AppFooter from '../../../components/AppFooter';
import BookingSidebar from '../../../components/BookingSidebar';
import { tours } from '../../../data/tours';

export function getStaticPaths() {
  return tours.en.map((tour) => ({
    params: { id: tour.id },
    props: { tour },
  }));
}

const { tour } = Astro.props;

// Mock data if specific tour doesn't have detailed itinerary yet
const itinerary = tour.itinerary || [
  { day: 1, title: 'Arrival & Acclimatization', description: 'Briefing at our Cusco headquarters and acclimatization in the high Andes.' },
  { day: 2, title: 'The Expedition Begins', description: 'Early departure, trekking through spectacular Andean landscapes.' }
];

const included = tour.included || [
  'Professional English-speaking guide',
  'Private transport',
  'All entrance fees and permits',
  'First aid kit and oxygen'
];

const notIncluded = tour.notIncluded || [
  'Travel insurance',
  'Personal trekking gear',
  'Gratuities'
];

const parts = tour.image.split('/');
let folder = parts.length > 3 ? parts[2] : null;

let bgFolder = (folder && ['alternative-trek', 'inca-trail', 'luxury', 'other-treks', 'tour-diarios'].includes(folder)) 
  ? folder 
  : null;

if (!bgFolder) {
  const id = tour.id.toLowerCase();
  if (id.includes('inca-trail')) bgFolder = 'inca-trail';
  else if (id.includes('luxury') || id.includes('vip')) bgFolder = 'luxury';
  else if (id.includes('-1d') || id.includes('tour') || id.includes('lake') || id.includes('rainbow') || id.includes('waqrapukara') || id.includes('palccoyo')) bgFolder = 'tour-diarios';
  else bgFolder = 'alternative-trek';
}

const heroImage = `/images/${bgFolder}/bg-${bgFolder}.avif`;
---

<Layout title={`${tour.title} | Machu Picchu Andes Marathon`} lang="en">
  <AppNav lang="en" currentPath={`/en/tours/${tour.id}`} switchUrl={`/es/tours/${tour.id}`} client:load />
  
  <main class="bg-white">
    <!-- Hero Header -->
    <div class="relative h-[60vh] min-h-[500px] w-full flex items-center justify-center overflow-hidden bg-[#01324c]">
      <img src={heroImage} alt={tour.title} class="absolute inset-0 w-full h-full object-cover opacity-80" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#01324c]/80 via-[#0b3d59]/50 to-[#01324c]/90"></div>
      
      <div class="relative z-10 px-6 max-w-5xl mx-auto w-full text-center flex flex-col items-center mt-16">
        <span class="inline-block py-1.5 px-4 mb-6 rounded-full bg-amber-500/20 text-amber-400 font-outfit font-bold tracking-widest uppercase text-xs sm:text-sm border border-amber-500/30 backdrop-blur-md shadow-[0_0_15px_rgba(245,158,11,0.2)]">
          {tour.category} • {tour.duration}
        </span>
        <h1 class="font-outfit font-black text-3xl sm:text-4xl md:text-5xl lg:text-5xl text-white leading-tight tracking-tight drop-shadow-2xl max-w-4xl">
          {tour.title}
        </h1>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-6 lg:px-12 py-8 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">
        
        <!-- Left Column: Details -->
        <div class="lg:col-span-2 space-y-16">
          <section>
            <h2 class="text-3xl font-['Playfair_Display'] font-bold text-gray-900 mb-6 border-b pb-4 text-center md:text-left">Overview</h2>
            <p class="text-gray-600 text-lg leading-relaxed">
              {tour.description}
            </p>
          </section>

          <section>
            <h2 class="text-3xl font-['Playfair_Display'] font-bold text-gray-900 mb-8 border-b pb-4 text-center md:text-left">Day by Day Itinerary</h2>
            <div class="space-y-8 relative before:absolute before:inset-y-0 before:left-1/2 before:-translate-x-1/2 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-gray-200 before:to-transparent before:z-0">
              {itinerary.map((item, idx) => (
                <div class="relative z-10 flex flex-col md:flex-row md:items-start md:justify-normal md:odd:flex-row-reverse group is-active gap-3 md:gap-0">
                  <div class="flex items-center justify-center mx-auto md:mx-0 w-10 h-10 rounded-full border-4 border-white bg-amber-500 text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-20 font-bold relative">
                    {item.day || idx + 1}
                  </div>
                  <div class="w-full md:w-[calc(50%-2.5rem)] bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow rounded-2xl p-5 md:p-6 z-10 relative">
                    <h3 class="font-bold text-xl text-gray-900 mb-2">{item.title}</h3>
                    <p class="text-gray-600 leading-relaxed text-sm">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <section class="space-y-6 md:space-y-8">
            <div class="bg-green-50/50 rounded-3xl p-6 md:p-8 border border-green-100">
              <h3 class="text-2xl font-['Playfair_Display'] font-bold text-gray-900 mb-6 text-center md:text-left">
                What is Included
              </h3>
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {included.map(item => (
                  <li class="flex items-start">
                    <svg class="w-5 h-5 text-green-500 mr-2 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span class="text-gray-700 text-sm">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            
            <div class="bg-red-50/50 rounded-3xl p-6 md:p-8 border border-red-100">
              <h3 class="text-2xl font-['Playfair_Display'] font-bold text-gray-900 mb-6 text-center md:text-left">
                Not Included
              </h3>
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {notIncluded.map(item => (
                  <li class="flex items-start">
                    <svg class="w-5 h-5 text-red-400 mr-2 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    <span class="text-gray-700 text-sm">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        </div>

        <!-- Right Column: Sticky Booking -->
        <div class="lg:col-span-1">
          <BookingSidebar 
            client:load 
            tourTitle={tour.title} 
            duration={tour.duration} 
            category={tour.category} 
            lang="en" 
          />
        </div>

      </div>
    </div>
    <AppFooter lang="en" client:visible />
  </main>
</Layout>
